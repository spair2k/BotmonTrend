<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>BotmonTrend</AssemblyName>
    <RootNamespace>BotmonTrend</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Version>1.4.2</Version>
    <DebugType>none</DebugType>
    <!-- MIT License, Q8b1Q@ya.ru (c) 2026 -->
    <AssemblyInformationalVersion>1.4.2 (MIT) Q8b1Q@ya.ru (c) 2026</AssemblyInformationalVersion>

    <!-- the game root: the folder that contains BepInEx and EscapeFromTarkov.exe.
         pass it on the command line: dotnet build -p:GamePath="C:\path\to\your SPT folder" -->
    <DataDirs Condition="'$(GamePath)' != ''">$([System.IO.Directory]::GetDirectories('$(GamePath)', '*_Data'))</DataDirs>
    <GameDataDir Condition="'$(DataDirs)' != ''">$([System.String]::Copy('$(DataDirs)').Split(';')[0])</GameDataDir>
    <ManagedDir>$(GameDataDir)\Managed</ManagedDir>
  </PropertyGroup>

  <Target Name="EnsureGamePath" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(GamePath)' == ''" Text="GamePath is required. Pass the game root (the folder that contains BepInEx and EscapeFromTarkov.exe): dotnet build -p:GamePath=&quot;C:\path\to\your SPT folder&quot;" />
  </Target>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(GamePath)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GamePath)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
